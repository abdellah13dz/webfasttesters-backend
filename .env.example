# REQUIRED for Render/production: Supabase session pooler (port 5432)
DATABASE_URL="postgresql://postgres.arvrqhurqwbuvwqibeou:Benahmed13tlm@aws-0-eu-west-1.pooler.supabase.com:5432/postgres?sslmode=require"
# Optional if auto-rewrite region differs from eu-west-1

SUPABASE_POOLER_REGION=eu-west-1
# Do NOT use on Render — direct host is IPv6-only:
# postgresql://postgres:PASSWORD@db.PROJECT_REF.supabase.co:5432/postgres?sslmode=require
PORT=4000
# Public marketing site (CORS + links in emails)
FRONTEND_URL=https://fasttesters.com
SITE_URL=https://fasttesters.com
# Extra browser origins allowed to call the API (comma-separated)
ALLOWED_ORIGINS=http://localhost:3000
RECAPTCHA_SECRET_KEY=

# JWT signing secret — must match frontend AUTH_JWT_SECRET
JWT_SECRET=dev-secret-change-in-production
JWT_EXPIRES_IN=7d

# Set to true to allow POST /api/admin/seed in production
ALLOW_SEED=false

# Make.com automation API keys are stored hashed in AutomationApiKey (DB).
# Create one with: npm run automation:create-key -- --name "Make.com"
# Set AUTOMATION_INTEGRATION=1 only when running disposable draft integration tests.
# AUTOMATION_INTEGRATION=0

# Optional override for new contact form notifications (defaults to SMTP_FROM / admin user email)
ADMIN_NOTIFY_EMAIL=

# Brevo email — credential env var is SMTP_KEY only (do not use SMTP_PASSWORD).
# Local dev: xsmtpsib-... SMTP relay key (port 587).
# Render/cloud: xkeysib-... API key in SMTP_KEY (HTTPS port 443; SMTP ports are blocked).
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=your-brevo-smtp-login@smtp-brevo.com
SMTP_KEY=your-brevo-key
SMTP_FROM=noreply@fasttesters.com
SMTP_FROM_NAME=Fast Testers
SMTP_CONNECTION_TIMEOUT=10000
SMTP_SOCKET_TIMEOUT=15000
# Optional separate inbox for contact/submission alerts (defaults to SMTP_FROM)
SMTP_NOTIFY_EMAIL=
# Optional alias for SMTP_KEY on cloud (prefer SMTP_KEY)
# BREVO_API_KEY=
# Force transport: smtp (local only) — default on Render is Brevo HTTPS API
# SMTP_TRANSPORT=smtp

# Cloudflare R2 (S3-compatible) — recommended for production uploads
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
# Public bucket URL (custom domain or r2.dev): https://assets.fasttesters.com
R2_PUBLIC_URL=
# Optional override (default: https://<R2_ACCOUNT_ID>.r2.cloudflarestorage.com)
# R2_ENDPOINT=
# UPLOAD_MAX_IMAGE_BYTES=5242880
# UPLOAD_MAX_FILE_BYTES=20971520

# Local disk fallback when R2_* vars are not set (dev only)
# UPLOAD_DIR=/var/data/uploads
