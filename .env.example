# REQUIRED for Render/production: Supabase session pooler (port 5432)
DATABASE_URL="postgresql://postgres.arvrqhurqwbuvwqibeou:Benahmed13tlm@aws-0-eu-west-1.pooler.supabase.com:5432/postgres?sslmode=require"
# Optional if auto-rewrite region differs from eu-west-1

SUPABASE_POOLER_REGION=eu-west-1
# Do NOT use on Render — direct host is IPv6-only:
# postgresql://postgres:PASSWORD@db.PROJECT_REF.supabase.co:5432/postgres?sslmode=require
PORT=4000
# Public marketing site (CORS + links in emails)
FRONTEND_URL=https://fasttesters.com
SITE_URL=https://fasttesters.com
# Extra browser origins allowed to call the API (comma-separated)
ALLOWED_ORIGINS=http://localhost:3000
RECAPTCHA_SECRET_KEY=

# JWT signing secret — must match frontend AUTH_JWT_SECRET
JWT_SECRET=dev-secret-change-in-production
JWT_EXPIRES_IN=7d

# Set to true to allow POST /api/admin/seed in production
ALLOW_SEED=false

# Optional override for new contact form notifications (defaults to SMTP_FROM / admin user email)
ADMIN_NOTIFY_EMAIL=

# Brevo SMTP (used when no admin DB config exists; also auto-synced to DB on first boot)
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=your-brevo-smtp-login@smtp-brevo.com
SMTP_KEY=your-brevo-smtp-key
SMTP_FROM=noreply@fasttesters.com
SMTP_FROM_NAME=Fast Testers
SMTP_CONNECTION_TIMEOUT=10000
SMTP_SOCKET_TIMEOUT=15000
# Optional separate inbox for contact/submission alerts (defaults to SMTP_FROM)
SMTP_NOTIFY_EMAIL=
